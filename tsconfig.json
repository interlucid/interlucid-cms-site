{
    "ts-node": {
        "require": ["tsconfig-paths/register"]
    },
    "compilerOptions": {
        "types": ["react-router", "vite/client"],
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["DOM", "DOM.Iterable", "ES2019"],
        "isolatedModules": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "target": "ES2019",
        "strict": true,
        "baseUrl": "./",
        "rootDirs": [".", "./.react-router/types"],
        "paths": {
            "@app/*": ["./app/*"],
            "@genTypes/*": ["./types/*"]
        },
        "noEmit": true
    },
    "include": [".react-router/types/**/*", "app/**/*", "types/**/*"]
}
