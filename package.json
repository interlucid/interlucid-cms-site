{
    "name": "interlucid-cms-site",
    "version": "0.0.2",
    "description": "A site for the Interlucid music project that uses a headless CMS",
    "scripts": {
        "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
        "dev": "concurrently \"npm run dev:css\" \"react-router dev\"",
        "gen-types": "dotenv -- bash -c 'cf-content-types-generator --v10 -r -s $CONTENTFUL_SPACE_ID -t $CONTENTFUL_MANAGEMENT_API_ACCESS_TOKEN --out types'",
        "typecheck": "react-router typegen && tsc",
        "lint": "tsc && eslint --ext .ts,.tsx app/{components,routes}/** --fix",
        "test": "echo lol you think we test this thing",
        "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
        "build": "npm run build:css && react-router build",
        "start": "react-router-serve build/server/index.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/interlucid/interlucid-cms-site.git"
    },
    "keywords": [
        "interlucid",
        "website",
        "cms"
    ],
    "author": "Brandon der Blätter",
    "license": "UNLICENSED",
    "bugs": {
        "url": "https://github.com/interlucid/interlucid-cms-site/issues"
    },
    "homepage": "https://github.com/interlucid/interlucid-cms-site#readme",
    "dependencies": {
        "@react-router/node": "^7.2.0",
        "@react-router/serve": "^7.2.0",
        "dotenv": "^16.4.7",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@contentful/rich-text-types": "^17.0.0",
        "@eslint/js": "^9.23.0",
        "@react-router/dev": "^7.2.0",
        "@tailwindcss/cli": "^4.0.8",
        "@tailwindcss/postcss": "^4.0.8",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "cf-content-types-generator": "^2.15.5",
        "concurrently": "^9.1.2",
        "contentful": "11.5.10",
        "contentful-management": "^11.48.1",
        "dotenv-cli": "^8.0.0",
        "eslint": "^9.23.0",
        "eslint-config-prettier": "^10.1.1",
        "postcss": "^8.5.3",
        "prettier": "3.5.3",
        "tailwindcss": "^4.0.8",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.27.0",
        "vite": "^6.1.1",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "engines": {
        "node": ">=18"
    }
}
